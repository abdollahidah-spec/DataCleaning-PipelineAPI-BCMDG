# --- SQL Server (source E11 — LECTURE SEULE, aucune écriture/DDL sur cette base) ---
DB_USER=CHANGE_ME
DB_PASSWORD=CHANGE_ME
DB_HOST=CHANGE_ME
DB_PORT=1433
DB_NAME=DATAWAREHOUSE_SA_PROD
DB_DRIVER=ODBC Driver 17 for SQL Server

# --- Claude (fallback NomCorrespondant, Produits, NomDonneurOrdre, Bénéficiaire, Pays) ---
ANTHROPIC_API_KEY=sk-ant-CHANGE_ME

# --- Fichiers de référence externes (E08_OCD : NomDonneurOrdre, Bénéficiaire) ---
# Toujours des chemins EXPLICITES en .env, jamais en dur dans le code — voir
# e08_ocd/fields/_entity_matching.py. Vide = fonctionnalité concernée dégradée
# proprement (DGI_BASE_PATH absent -> erreur claire au chargement ; PUBLIC_ENT_PATH
# absent -> liste vide, pas d'erreur, juste aucune entreprise publique reconnue).
DGI_BASE_PATH=req/Base_Fiscale_DGI_Mauritanie.xlsx
PUBLIC_ENT_PATH=req/public_ent.xlsx

# --- Stockage local/réseau (chemin exact, AUCUN besoin de SharePoint) ---
# Si définie, tous les livrables (CSV, classeurs) sont écrits sous
# {OUTPUT_BASE}/e11_rdcc/outputs/... au lieu du dossier relatif du repo.
# Peut être un dossier local (D:\BCM_Outputs) ou un partage réseau (\\serveur\partage).
# C'est le mécanisme de stockage principal tant que SharePoint n'est pas configuré.
OUTPUT_BASE=

# --- État incrémental (fichier JSON local — PAS une table SQL) ---
# La base source E11 reste strictement en lecture seule (aucune écriture/DDL
# autorisée) : l'état incrémental (dernier dtCr traité, compteurs cumulatifs) est
# simulé localement dans un fichier JSON. Vide = e11_rdcc/state/ (fonctionne déjà).
STATE_DIR=

# --- SharePoint (Microsoft Graph, client-credentials / MSAL) — OPTIONNEL, à activer plus tard ---
# Laisser vide = upload SharePoint simplement ignoré (pas d'erreur), OUTPUT_BASE suffit.
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_URL=
SHAREPOINT_FOLDER_PATH=

# --- Notifications email (Gmail SMTP) — OPTIONNEL, à activer plus tard ---
# Laisser vide = notification simplement ignorée (pas d'erreur).
# SMTP_USER = l'adresse Gmail qui envoie. SMTP_APP_PASSWORD = PAS le mot de passe du
# compte — un "mot de passe d'application" à générer une fois (2 min, voir README).
# EMAIL_TO = la ou les adresses qui reçoivent (simple liste, rien à générer).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
EMAIL_TO=
EMAIL_MAX_ATTACHMENT_MB=15

# --- Optionnel ---
LOG_LEVEL=INFO
